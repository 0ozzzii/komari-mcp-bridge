diff --git a/src/utils/clientToken.ts b/src/utils/clientToken.ts
new file mode 100644
index 0000000..d071bce
--- /dev/null
+++ b/src/utils/clientToken.ts
@@ -0,0 +1,43 @@
+import { t } from "i18next";
+
+type ClientTokenPayload = {
+  token?: unknown;
+  data?: { token?: unknown };
+  message?: unknown;
+  error?: unknown;
+};
+
+export async function requestClientToken(uuid: string): Promise<string | null> {
+  const request = (twoFactorCode?: string) =>
+    fetch(`/api/admin/client/${encodeURIComponent(uuid)}/token`, {
+      headers: twoFactorCode ? { "X-2FA-Code": twoFactorCode } : undefined,
+    });
+
+  let response = await request();
+  if (response.status === 401) {
+    const code = window.prompt(
+      t(
+        "account.2fa_otp_input_prompt",
+        "Please enter the one-time password from your authenticator app"
+      )
+    );
+    if (!code?.trim()) return null;
+    response = await request(code.trim());
+  }
+
+  const payload = (await response.json().catch(() => null)) as
+    | ClientTokenPayload
+    | null;
+  if (!response.ok) {
+    const detail = payload?.message ?? payload?.error;
+    throw new Error(
+      typeof detail === "string" && detail ? detail : `HTTP ${response.status}`
+    );
+  }
+
+  const token = payload?.token ?? payload?.data?.token;
+  if (typeof token !== "string" || !token) {
+    throw new Error("Client token was not returned");
+  }
+  return token;
+}
