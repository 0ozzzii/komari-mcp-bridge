diff --git a/src/config/agentRelease.ts b/src/config/agentRelease.ts
new file mode 100644
index 0000000..769f883
--- /dev/null
+++ b/src/config/agentRelease.ts
@@ -0,0 +1,145 @@
+import { useEffect, useState } from "react";
+
+// Build-time release identity: one source for all installation dialogs.
+const repository = import.meta.env.VITE_KOMARI_AGENT_REPOSITORY || "0ozzzii/komari-mcp-bridge";
+export const agentReleaseVersion = import.meta.env.VITE_KOMARI_AGENT_VERSION || "";
+const installRef = import.meta.env.VITE_KOMARI_AGENT_INSTALL_REF || agentReleaseVersion || "main";
+const imageRepository = import.meta.env.VITE_KOMARI_IMAGE_REPOSITORY || "ghcr.io/0ozzzii/komari-mcp-bridge";
+
+export type AgentInstallRoute = "github-direct" | "mirror-direct" | "github-cft";
+
+export type AgentInstallRoutes = {
+  direct_report_url: string;
+  download_base_url?: string;
+  cft_report_url?: string;
+};
+
+export type ResolvedAgentInstallRoute = {
+  reportUrl: string;
+  scriptUrl: string;
+  args: string[];
+  available: boolean;
+};
+
+let installRoutesPromise: Promise<AgentInstallRoutes | null> | undefined;
+
+function configuredHttpsUrl(value: unknown): string | undefined {
+  if (typeof value !== "string") return undefined;
+  const candidate = value.trim();
+  if (!candidate || /[\r\n\t\s]/.test(candidate)) return undefined;
+
+  try {
+    const parsed = new URL(candidate);
+    if (
+      parsed.protocol !== "https:" ||
+      parsed.username ||
+      parsed.password ||
+      parsed.search ||
+      parsed.hash
+    ) {
+      return undefined;
+    }
+    return candidate.replace(/\/+$/, "");
+  } catch {
+    return undefined;
+  }
+}
+
+export function loadAgentInstallRoutes(): Promise<AgentInstallRoutes | null> {
+  if (!installRoutesPromise) {
+    installRoutesPromise = fetch(
+      `${window.location.origin}/komari-ai-v2-downloads/install-routes.json`,
+      { cache: "no-store" }
+    )
+      .then(async (response) => {
+        if (!response.ok) return null;
+        const raw: unknown = await response.json();
+        if (!raw || typeof raw !== "object") return null;
+        const values = raw as Record<string, unknown>;
+        const direct = configuredHttpsUrl(values.direct_report_url);
+        if (!direct) return null;
+        const download = configuredHttpsUrl(values.download_base_url);
+        const cft = configuredHttpsUrl(values.cft_report_url);
+        return {
+          direct_report_url: direct,
+          ...(download ? { download_base_url: download } : {}),
+          ...(cft ? { cft_report_url: cft } : {}),
+        };
+      })
+      .catch(() => null);
+  }
+  return installRoutesPromise;
+}
+
+export function useAgentInstallRoutes() {
+  const [routes, setRoutes] = useState<AgentInstallRoutes | null>(null);
+  useEffect(() => {
+    let active = true;
+    void loadAgentInstallRoutes().then((loaded) => {
+      if (active) setRoutes(loaded);
+    });
+    return () => {
+      active = false;
+    };
+  }, []);
+  return routes;
+}
+
+export function resolveAgentInstallRoute(
+  route: AgentInstallRoute,
+  routes: AgentInstallRoutes | null,
+  fallbackReportUrl: string,
+  requestedVersion = agentReleaseVersion
+): ResolvedAgentInstallRoute {
+  if (route === "mirror-direct") {
+    const base = routes?.download_base_url;
+    const selectedVersion = requestedVersion.trim();
+    if (!base || !selectedVersion) {
+      return { reportUrl: "", scriptUrl: "", args: [], available: false };
+    }
+    return {
+      reportUrl: routes?.direct_report_url || fallbackReportUrl,
+      scriptUrl: `${base}/${encodeURIComponent(selectedVersion)}/install.sh`,
+      args: ["--install-base-url", base],
+      available: true,
+    };
+  }
+
+  if (route === "github-cft") {
+    if (!routes?.cft_report_url) {
+      return { reportUrl: "", scriptUrl: "", args: [], available: false };
+    }
+    return {
+      reportUrl: routes.cft_report_url,
+      scriptUrl: agentInstallScript("install.sh"),
+      args: ["--install-no-mirror"],
+      available: true,
+    };
+  }
+
+  return {
+    reportUrl: routes?.direct_report_url || fallbackReportUrl,
+    scriptUrl: agentInstallScript("install.sh"),
+    args: ["--install-no-mirror"],
+    available: true,
+  };
+}
+
+export function agentInstallRouteLabel(route: AgentInstallRoute): string {
+  switch (route) {
+    case "mirror-direct":
+      return "镜像下载 · 直连上报";
+    case "github-cft":
+      return "GitHub 下载 · CFT 上报";
+    default:
+      return "GitHub 下载 · 直连上报";
+  }
+}
+
+export function agentInstallScript(file: "install.sh" | "install.ps1") {
+  return `https://raw.githubusercontent.com/${repository}/${installRef}/${file}`;
+}
+export function agentInstallVersionArgs(): string[] {
+  return agentReleaseVersion ? ["--install-version", agentReleaseVersion] : [];
+}
+export const agentDockerImage = `${imageRepository.toLowerCase()}-agent:${agentReleaseVersion || "latest"}`;
