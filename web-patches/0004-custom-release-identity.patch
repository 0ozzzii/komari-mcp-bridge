+// Our release line is independent of the official Komari version line.
+export const panelReleaseRepository = import.meta.env.VITE_KOMARI_PANEL_REPOSITORY || import.meta.env.VITE_KOMARI_AGENT_REPOSITORY || "0ozzzii/komari-mcp-bridge";
+export const panelReleasesAPI = `https://api.github.com/repos/${panelReleaseRepository}/releases?per_page=100`;
