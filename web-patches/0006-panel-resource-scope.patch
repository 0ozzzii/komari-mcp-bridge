diff --git a/src/utils/resourceScope.ts b/src/utils/resourceScope.ts
new file mode 100644
index 0000000..13e959a
--- /dev/null
+++ b/src/utils/resourceScope.ts
@@ -0,0 +1,43 @@
+export type ResourceScope = Record<string, string> | undefined;
+
+export function getResourceMetricStatus(
+  scope: ResourceScope,
+  statusKey: string,
+  legacyKey?: string,
+  message?: string
+): string | undefined {
+  const status = scope?.[statusKey] || (legacyKey ? scope?.[legacyKey] : "");
+  if (status) return status.trim().toLowerCase();
+
+  const hasLegacyContainerMarker =
+    message?.includes("resource_scope=container") ?? false;
+  if (
+    hasLegacyContainerMarker &&
+    (statusKey === "disk_total_status" || statusKey === "load_status")
+  ) {
+    return "unknown";
+  }
+  return undefined;
+}
+
+export function isResourceMetricUnavailable(
+  scope: ResourceScope,
+  statusKey: string,
+  legacyKey?: string,
+  message?: string
+): boolean {
+  const status = getResourceMetricStatus(scope, statusKey, legacyKey, message);
+  return Boolean(
+    status &&
+      [
+        "unknown",
+        "pending",
+        "unavailable",
+        "unsupported",
+        "not_available",
+        "not_supported",
+        "missing",
+        "error",
+      ].includes(status)
+  );
+}
