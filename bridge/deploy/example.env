# Placeholders only. Keep the actual file private and outside source control.
KOMARI_BASE_URL=https://<komari-panel-host>
KOMARI_API_KEY=<administrator-api-key>
BRIDGE_CONTROL_TOKEN=<independent-random-control-token-at-least-32-characters>
BRIDGE_BIND_ADDRESS=127.0.0.1:8967
BRIDGE_CONTROL_ADDRESS=127.0.0.1:8968
BRIDGE_STATE_DIR=/var/lib/komari-mcp
SESSION_IDLE_TIMEOUT=30m
CONNECTION_READY_TIMEOUT=60s
OUTPUT_RETENTION=24h
OUTPUT_BUFFER_LIMIT=2097152
SESSION_LIMIT=64
# Optional Komari panel environment (same control token, server-side only):
# KOMARI_MCP_CONTROL_URL=http://127.0.0.1:8968
# KOMARI_MCP_CONTROL_TOKEN=<same-independent-control-token>
# Optional single-domain entry: public /mcp is forwarded by the panel, with
# caller Bearer authentication and the SDK's localhost protection preserved.
# KOMARI_MCP_UPSTREAM_URL=http://127.0.0.1:8967/mcp
