+func (s *terminalSession) writeInput(conn *websocket.Conn, data []byte) bool {
+	s.mu.Lock()
+	current := !s.removed && s.conn == conn
+	s.mu.Unlock()
+	if !current {
+		return false
+	}
+	n, err := s.term.Write(data)
+	if err != nil || n != len(data) {
+		s.detach(conn)
+		return false
+	}
+	return true
