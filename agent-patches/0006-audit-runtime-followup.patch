+func validateReportIntervals(cfg *pkg_flags.Config) error {
+	if cfg.InfoReportInterval <= 0 || int64(cfg.InfoReportInterval) > int64(math.MaxInt64/time.Minute) {
+		return fmt.Errorf("invalid --info-report-interval: expected a positive duration in minutes")
+	}
+	if cfg.ReconnectInterval <= 0 || int64(cfg.ReconnectInterval) > int64(math.MaxInt64/time.Second) {
+		return fmt.Errorf("invalid --reconnect-interval: expected a positive duration in seconds")
+	}
+	if cfg.Interval <= 0 || math.IsNaN(cfg.Interval) || cfg.Interval >= float64(math.MaxInt64)/float64(time.Second) {
+		return fmt.Errorf("invalid --interval: expected a finite positive duration in seconds")
+	}
+	return nil
+}
