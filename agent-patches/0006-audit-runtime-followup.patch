+func TestTaskDeadlineSeparatesInitialDNSFromHTTP(t *testing.T) {
+	hosts := make(chan string, 1)
+	web := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, request *http.Request) {
+		hosts <- request.Host
+		w.WriteHeader(http.StatusNoContent)
+	}))
+	defer web.Close()
+	target := strings.Replace(web.URL, "127.0.0.1", "probe.test", 1)
+	timeout := 200 * time.Millisecond
+	delay := 2 * timeout
+	_, err := httpPingWithResolver(target, timeout, func(ctx context.Context, name string) (string, error) {
+		if name != "probe.test" {
+			return "", fmt.Errorf("unexpected DNS name: %s", name)
+		}
+		deadline, ok := ctx.Deadline()
+		if !ok || time.Until(deadline) < delay {
+			return "", errors.New("DNS inherited the HTTP deadline")
+		}
+		return "127.0.0.1", nil
+	})
+	host := ""
+	select {
+	case host = <-hosts:
+	default:
+	}
+	if err != nil || !strings.HasPrefix(host, "probe.test:") {
+		t.Fatalf("HTTP probe lost origin host or failed: host=%q err=%v", host, err)
+	}
+}
