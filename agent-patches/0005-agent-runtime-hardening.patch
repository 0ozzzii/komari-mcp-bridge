--- /dev/null
+++ b/cmd/runtime_test.go
@@ -0,0 +1,24 @@
+package cmd
+
+import (
+	"testing"
+)
+
+func TestReportIntervalDefaults(t *testing.T) {
+	for arch, want := range map[string]float64{"arm": 5, "arm64": 5, "amd64": 3, "386": 3} {
+		if got := defaultReportInterval(arch); got != want {
+			t.Errorf("%s: got %v, want %v", arch, got, want)
+		}
+	}
+	original := *flags
+	t.Cleanup(func() { *flags = original })
+	flag := RootCmd.PersistentFlags().Lookup("interval")
+	if err := flag.Value.Set("9"); err != nil || flags.Interval != 9 {
+		t.Fatalf("--interval override failed: %v, %v", flags.Interval, err)
+	}
+	t.Setenv("AGENT_INTERVAL", "11.5")
+	loadFromEnv()
+	if flags.Interval != 11.5 {
+		t.Fatalf("AGENT_INTERVAL override lost: %v", flags.Interval)
+	}
+}
