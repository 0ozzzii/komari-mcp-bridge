diff --git a/server/task_probe_test.go b/server/task_probe_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..2cea9b45a34af2e597791dbb3280de62d61f7471
--- /dev/null
+++ b/server/task_probe_test.go
@@ -0,0 +1,94 @@
+package server
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"net"
+	"os"
+	"reflect"
+	"syscall"
+	"testing"
+	"time"
+
+	"github.com/komari-monitor/komari-agent/dnsresolver"
+	"golang.org/x/net/dns/dnsmessage"
+)
+
+// The release workflow selects the TestTaskDeadline family for server tests.
+func TestTaskDeadlineAndProbeNetwork(t *testing.T) {
+	t.Run("custom DNS and deadline", func(t *testing.T) {
+		conn, err := net.ListenPacket("udp4", "127.0.0.1:0")
+		if err != nil {
+			t.Fatal(err)
+		}
+		defer conn.Close()
+		done := make(chan struct{})
+		go func() {
+			defer close(done)
+			buf := make([]byte, 4096)
+			for {
+				n, from, err := conn.ReadFrom(buf)
+				if err != nil {
+					return
+				}
+				var request dnsmessage.Message
+				if err := request.Unpack(buf[:n]); err != nil || len(request.Questions) != 1 {
+					continue
+				}
+				q := request.Questions[0]
+				response := dnsmessage.Message{
+					Header:    dnsmessage.Header{ID: request.ID, Response: true, RecursionAvailable: true},
+					Questions: request.Questions,
+				}
+				if q.Type == dnsmessage.TypeA {
+					response.Answers = []dnsmessage.Resource{{
+						Header: dnsmessage.ResourceHeader{Name: q.Name, Type: dnsmessage.TypeA, Class: dnsmessage.ClassINET, TTL: 60},
+						Body:   &dnsmessage.AResource{A: [4]byte{198, 51, 100, 42}},
+					}}
+				}
+				if packet, err := response.Pack(); err == nil {
+					_, _ = conn.WriteTo(packet, from)
+				}
+			}
+		}()
+		defer func() { _ = conn.Close(); <-done }()
+		old := dnsresolver.CustomDNSServer
+		t.Cleanup(func() { dnsresolver.CustomDNSServer = old })
+		dnsresolver.SetCustomDNSServer(conn.LocalAddr().String())
+		got, err := resolveIP(t.Context(), "komari-probe.test.")
+		if err != nil || got != "198.51.100.42" {
+			t.Fatalf("probe ignored custom DNS: got=%q err=%v", got, err)
+		}
+		ctx, cancel := context.WithDeadline(t.Context(), time.Now().Add(-time.Second))
+		defer cancel()
+		if _, err := resolveIP(ctx, "komari-aborted.test."); err == nil {
+			t.Fatal("probe DNS lookup ignored deadline")
+		}
+	})
+	t.Run("ICMP privilege fallback", func(t *testing.T) {
+		var modes []bool
+		run := func(privileged bool) (int64, error) {
+			modes = append(modes, privileged)
+			if privileged {
+				return -1, fmt.Errorf("socket: %w", &os.SyscallError{Syscall: "socket", Err: syscall.EPERM})
+			}
+			return 17, nil
+		}
+		if ms, err := probeICMPWithFallback(true, true, run); err != nil || ms != 17 || !reflect.DeepEqual(modes, []bool{true, false}) {
+			t.Fatalf("raw-to-datagram fallback: ms=%d err=%v modes=%v", ms, err, modes)
+		}
+		modes = nil
+		if ms, err := probeICMPWithFallback(false, true, run); err != nil || ms != 17 || !reflect.DeepEqual(modes, []bool{false}) {
+			t.Fatalf("unprivileged datagram: ms=%d err=%v modes=%v", ms, err, modes)
+		}
+		want := errors.New("no ICMP response")
+		calls := 0
+		if _, err := probeICMPWithFallback(true, true, func(bool) (int64, error) {
+			calls++
+			return -1, want
+		}); !errors.Is(err, want) || calls != 1 {
+			t.Fatalf("ordinary failure retried: err=%v calls=%d", err, calls)
+		}
+	})
+}
